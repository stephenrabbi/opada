# Copy to .env.local (gitignored) for local work; set the same names in Vercel's
# encrypted env store for previews. Never commit values. See docs/engineering/STAGING_SETUP.md.

# Postgres connection string. The app uses the Neon serverless driver; db:migrate/db:seed accept any Postgres.
DATABASE_URL=
# Paystack TEST secret key only (must start with sk_test_). Also used to verify webhook signatures.
PAYSTACK_TEST_SECRET_KEY=
# Google AI Studio key for Gemini extraction (server-side only).
GEMINI_API_KEY=
# Optional. Default gemini-2.5-flash.
GEMINI_MODEL=
# Optional. Lowers the daily Gemini call cap (Africa/Lagos day). Hard maximum 200.
GEMINI_DAILY_CALL_CAP=
# Keep false: Google Cloud Speech-to-Text V2 is billed.
OPADA_GOOGLE_STT_ENABLED=false
# Only needed if STT is ever approved.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_STT_LOCATION=
# Optional. Lifetime of simulated-restaurant tokens issued by npm run db:seed (hours, default 72).
SEED_TOKEN_TTL_HOURS=
